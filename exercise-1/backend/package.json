{
  "name": "endorsement-translator-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Translates flat endorsement requests into the structured JSON expected by the insurance core.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "template:import": "tsx src/scripts/import-template.ts",
    "token": "tsx src/scripts/generate-token.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hapi/hapi": "^21.4.13",
    "@hapi/jwt": "^3.2.4",
    "better-sqlite3": "^12.11.1",
    "joi": "^18.3.2",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
